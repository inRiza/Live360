<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_home_family_icon_container"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgFamilyIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFamilyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Family Name"
                android:textColor="@color/grey_900"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/member1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_circle_small"
                    android:gravity="center"
                    android:text="A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/member2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_circle_small"
                    android:gravity="center"
                    android:text="B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/member3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_circle_small"
                    android:gravity="center"
                    android:text="C"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/memberExtra"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_circle_small_grey"
                    android:gravity="center"
                    android:text="+2"
                    android:textColor="@color/grey_600"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:backgroundTint="@color/blue_600"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:text="Join"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
