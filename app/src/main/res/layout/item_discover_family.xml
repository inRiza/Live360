<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp">
    <ImageView
        android:id="@+id/imgFamilyIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView
            android:id="@+id/tvFamilyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Name"
            android:textStyle="bold"
            android:textSize="14sp"/>
        <LinearLayout
            android:id="@+id/layoutMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/member1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_circle_small"
                android:gravity="center"
                android:text="A"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/member2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/bg_circle_small"
                android:gravity="center"
                android:text="B"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/member3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/bg_circle_small"
                android:gravity="center"
                android:text="C"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/memberExtra"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/bg_circle_small"
                android:gravity="center"
                android:text="+2"
                android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/btnJoin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join"
        android:textAllCaps="false"/>
</LinearLayout>
