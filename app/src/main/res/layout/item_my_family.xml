<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white"
    android:layout_marginEnd="12dp">
    <ImageView
        android:id="@+id/imgFamilyIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle" />
    <TextView
        android:id="@+id/tvFamilyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Family Name"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/tvMemberCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="6dp"
        android:text="0 members" />

    <!-- Members -->
    <LinearLayout
        android:id="@+id/layoutMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/member1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_small"
            android:gravity="center"
            android:text="A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/member2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/bg_circle_small"
            android:gravity="center"
            android:text="B"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/member3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/bg_circle_small"
            android:gravity="center"
            android:text="C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/memberExtra"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/bg_circle_small"
            android:gravity="center"
            android:text="+2"
            android:textSize="10sp" />

    </LinearLayout>
</LinearLayout>