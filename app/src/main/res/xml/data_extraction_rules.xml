<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="nimons360_secure_prefs.xml"/>

        <include domain="database" path="."/>
        <exclude domain="database" path="nimons360.db"/>
        <exclude domain="database" path="nimons360.db-shm"/>
        <exclude domain="database" path="nimons360.db-wal"/>
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="nimons360_secure_prefs.xml"/>

        <include domain="database" path="."/>
        <exclude domain="database" path="nimons360.db"/>
        <exclude domain="database" path="nimons360.db-shm"/>
        <exclude domain="database" path="nimons360.db-wal"/>
    </device-transfer>
</data-extraction-rules>